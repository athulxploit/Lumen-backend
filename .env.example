# Copy to .env for local runs:  uvicorn main:app --reload --env-file .env
# With Docker:                  docker run --env-file .env -p 8000:8000 research-api
# Keep comments on their own lines (Docker's --env-file does not strip inline comments).

# ── LLM (required) ───────────────────────────────────────────────────────────
# Any OpenAI-compatible chat-completions endpoint: OpenAI, OpenRouter, Groq, Together,
# Ollama (http://host:11434/v1), vLLM, ...
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# The model id your provider expects.
LLM_MODEL=your-model-id

# ── Search (required) ────────────────────────────────────────────────────────
# brave | serper | searxng
SEARCH_PROVIDER=brave
SEARCH_API_KEY=
# Only for SEARCH_PROVIDER=searxng (the instance must have the `json` format enabled):
# SEARXNG_URL=http://searxng:8080

# ── CORS ─────────────────────────────────────────────────────────────────────
# Exact origins of your Lovable frontend, comma-separated, no trailing slash: your published
# [name].lovable.app URL and/or custom domain. If you also test from the Lovable editor
# preview, add that preview origin too (copy it from the browser address bar).
ALLOWED_ORIGINS=https://your-project.lovable.app,https://your-domain.com
# Optional full-match regex. Avoid broad patterns like https://.*\.lovable\.app: they would
# allow every app hosted on lovable.app, not just yours.
# ALLOWED_ORIGIN_REGEX=

# ── Optional tuning (defaults shown; uncomment to change) ────────────────────
# Pages scraped in parallel:
# SEARCH_RESULTS=8
# Pages given to the model:
# MAX_SOURCES=5
# Characters kept per page:
# MAX_CHARS_PER_SOURCE=6000
# Per-page and whole-scrape wall-clock limits (seconds):
# PAGE_TIMEOUT_S=8
# SCRAPE_DEADLINE_S=10
# Drop a page entirely when this many of its sentences look like prompt injection:
# QUARANTINE_HITS=3
# Leave unset unless your model supports it:
# LLM_TEMPERATURE=
# Hard stop on streamed answer length:
# MAX_ANSWER_CHARS=16000
# SSE keep-alive interval (seconds):
# HEARTBEAT_S=10
